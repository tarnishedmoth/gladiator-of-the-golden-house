one_liners = Array[String](["Today is a good day to die!", "Are you not entertained?", "Strength and honor!", "I am pleased.", "Honorable warriors.", "Could this be my strongest?", "I demand more.", "I demand a real fight.", "I demand your strength.", "I demand your servitude.", "Combat is the great filter.", "I am your emperor.", "Impress me.", "I am impressed.", "Impressive.", "Satisfactory.", "Hm...", "I am not impressed.", "You have proven nothing.", "Fear me if you do not fear death."])
